# ============================================================
# PR Tracker — Environment Variables Template
# ============================================================

# Database & Authentication
MONGO_URI=mongodb://localhost:27017/prtracker
MONGODB_URI=mongodb://localhost:27017/prtracker
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret
JWT_SECRET=your_jwt_secret
ENCRYPTION_SECRET=your_encryption_secret
CLIENT_URL=http://localhost

# Frontend endpoint
VITE_SERVER_ENDPOINT=http://localhost:5000

# Main Backend & GitHub Webhook
GITHUB_TOKEN=your_github_token
GITHUB_WEBHOOK_SECRET=your_webhook_secret
WEBHOOK_URL=http://localhost:5000/api/webhooks/github

# AI Agent
MISTRAL_API_KEY=your_mistral_api_key

# Internal Services
AUTH_SERVICE_URL=http://backend:5005
CORE_SERVICE_URL=http://main-backend:5002
AI_SERVICE_URL=http://ai-agent:5003
DB_SERVICE_URL=http://mongodb:5004
